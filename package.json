{
  "name": "@hyperse/eslint-config-hyperse",
  "version": "2.1.0",
  "description": "🛠 These are settings for TypeScript / ESLint / Prettier in a project",
  "keywords": [
    "hyperse",
    "esm",
    "javascript",
    "ecmascript",
    "typescript",
    "eslint",
    "config",
    "prettier"
  ],
  "homepage": "git@github.com:hyperse-io/eslint-config-hyperse.git",
  "repository": {
    "type": "git",
    "url": "git@github.com:hyperse-io/eslint-config-hyperse.git"
  },
  "author": {
    "name": "Yingchun Tian",
    "url": "https://github.com/tianyingchun"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./base": {
      "import": "./dist/main/base.js",
      "types": "./dist/main/base.d.ts",
      "default": "./dist/main/base.js"
    },
    "./sonarjs": {
      "import": "./dist/main/sonarjs.js",
      "types": "./dist/main/sonarjs.d.ts",
      "default": "./dist/main/sonarjs.js"
    },
    "./reactjs": {
      "import": "./dist/main/reactjs.js",
      "types": "./dist/main/reactjs.d.ts",
      "default": "./dist/main/reactjs.js"
    },
    "./nextjs": {
      "import": "./dist/main/nextjs.js",
      "types": "./dist/main/nextjs.d.ts",
      "default": "./dist/main/nextjs.js"
    },
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./package.json": "./package.json",
    "./definePrettierConfig": {
      "import": "./dist/definePrettierConfig.js",
      "types": "./dist/definePrettierConfig.d.ts",
      "default": "./dist/definePrettierConfig.js"
    },
    "./getPrettierConfig": {
      "import": "./dist/definePrettierConfig.js",
      "types": "./dist/definePrettierConfig.d.ts",
      "default": "./dist/definePrettierConfig.js"
    }
  },
  "workspaces": [
    "examples/*",
    "./"
  ],
  "types": "./dist/index.d.ts",
  "files": [
    "./dist/",
    "./index.js",
    "./tsconfig.base.json"
  ],
  "scripts": {
    "build": "tsx ./scripts/build.ts",
    "changeset": "changeset",
    "clean": "rimraf --no-glob ./dist ./coverage ./.eslintcache ./tsconfig.tsbuildinfo",
    "cz": "cz",
    "lint": "TIMING=1 eslint .",
    "lint-staged-files": "lint-staged --allow-empty",
    "lint:fix": "npm run lint -- --fix",
    "prepare": "husky",
    "release": "yarn run build && changeset publish",
    "test": "vitest run",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "version": "changeset version"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.26.5",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.0",
    "@typescript-eslint/utils": "^8.71.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "app-root-path": "^3.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-mdx": "^3.8.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "get-tsconfig": "^4.14.3",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.71.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@swc/core": "^1.16.18",
    "@types/eslint__js": "^9.14.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.x",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "eslint": ">=9.39.0",
    "typescript": ">=5.4.3 <7"
  },
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22.11.0"
  }
}
